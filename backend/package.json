{
  "name": "uttam-lifecycle-backend",
  "version": "1.0.0",
  "description": "Uttam Laboratory — Ayurvedic Stock & Inventory Management API",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch-path=./src --watch src/index.js",
    "start": "node src/index.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "node seeds/seed.js",
    "db:clean": "node seeds/clean.js",
    "db:setup": "prisma db push && node seeds/clean.js"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "decimal.js": "^10.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "prisma": "^6.0.0"
  }
}
